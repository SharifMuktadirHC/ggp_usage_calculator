    saw: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="14" r="6"/><path d="M10 8v-1M10 20v1M4.6 10.4l-.7-.7M15.4 17.6l.7.7M4.6 17.6l-.7.7M15.4 10.4l.7-.7"/><path d="M16 14h5l-2-3-2 3z"/></svg>',
    truck: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="10" width="10" height="6" rx="1"/><path d="M12 12h4l3 3v1h-2"/><circle cx="6" cy="18" r="1.6"/><circle cx="16.5" cy="18" r="1.6"/><line x1="14" y1="7" x2="14" y2="12"/></svg>',
    cash: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="9" width="18" height="11" rx="1.5"/><path d="M6 9V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v3"/><line x1="7" y1="14" x2="10" y2="14"/><line x1="7" y1="17" x2="13" y2="17"/></svg>',
    coffee: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h13v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8z"/><path d="M17 9h1.5a2.5 2.5 0 0 1 0 5H17"/><line x1="7" y1="3" x2="7" y2="5"/><line x1="10.5" y1="3" x2="10.5" y2="5"/></svg>',
    printer: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="8" width="14" height="8" rx="1"/><path d="M7 8V4h10v4M7 16v4h10v-4"/></svg>',
    shield: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 5-3 8-7 9-4-1-7-4-7-9V6l7-3z"/></svg>',
    sign: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="9" rx="1.5"/><line x1="8" y1="20" x2="16" y2="20"/><line x1="12" y1="15" x2="12" y2="20"/><line x1="6.5" y1="10.5" x2="17.5" y2="10.5"/></svg>',
    heater: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2c1 3-2 4-2 7a3 3 0 0 0 6 0c0-1-.5-2-1-2 1 2-1 3-1 5a4 4 0 0 1-8 0c0-4 4-5 4-10"/></svg>',
    box: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7l9-4 9 4-9 4-9-4z"/><path d="M3 7v10l9 4 9-4V7"/><line x1="12" y1="11" x2="12" y2="21"/></svg>'
  };

  /* ---------------- Appliance database (approximate defaults — editable per row) ---------------- */
  var APPLIANCES = {
    household: [
      { name: 'LED Lighting', icon: 'bulb', watts: 10, hours: 5 },
      { name: 'Television', icon: 'tv', watts: 120, hours: 5 },
      { name: 'Fridge / Freezer', icon: 'fridge', watts: 150, hours: 24 },
      { name: 'Washing Machine', icon: 'washer', watts: 500, hours: 1 },
      { name: 'Microwave', icon: 'microwave', watts: 1000, hours: 0.5 },
      { name: 'Electric Kettle', icon: 'kettle', watts: 1200, hours: 0.3 },
      { name: 'Toaster', icon: 'toaster', watts: 900, hours: 0.2 },
      { name: 'Iron', icon: 'iron', watts: 1000, hours: 0.5 },
      { name: 'Hair Dryer', icon: 'hairdryer', watts: 1200, hours: 0.2 },
      { name: 'Air Conditioner', icon: 'ac', watts: 1500, hours: 4 },
      { name: 'Fan', icon: 'fan', watts: 75, hours: 6 },
      { name: 'Laptop', icon: 'laptop', watts: 65, hours: 4 },
      { name: 'Phone Charger', icon: 'phone', watts: 10, hours: 2 },
      { name: 'WiFi Router', icon: 'wifi', watts: 10, hours: 24 },
      { name: 'Dishwasher', icon: 'dishwasher', watts: 1200, hours: 1 },
      { name: 'Water Pump', icon: 'pump', watts: 750, hours: 1 }
    ],
    commercial: [
      { name: 'POS / Cash Register', icon: 'cash', watts: 60, hours: 10 },
      { name: 'Coffee Machine', icon: 'coffee', watts: 1200, hours: 6 },
      { name: 'Display Fridge / Freezer', icon: 'fridge', watts: 400, hours: 24 },
      { name: 'Commercial Lighting', icon: 'bulb', watts: 40, hours: 10 },
      { name: 'Split System A/C', icon: 'ac', watts: 2500, hours: 8 },
      { name: 'Computer / Monitor', icon: 'laptop', watts: 150, hours: 10 },
      { name: 'Printer / Copier', icon: 'printer', watts: 300, hours: 3 },
      { name: 'Security System / CCTV', icon: 'shield', watts: 50, hours: 24 },
      { name: 'Illuminated Signage', icon: 'sign', watts: 100, hours: 12 },
      { name: 'Exhaust Fan', icon: 'fan', watts: 120, hours: 10 },
      { name: 'Instant Water Heater', icon: 'heater', watts: 3000, hours: 1 }
    ],
    industrial: [
      { name: 'Air Compressor', icon: 'tank', watts: 2200, hours: 4 },
      { name: 'Welding Machine', icon: 'zap', watts: 4000, hours: 2 },
      { name: 'Angle Grinder', icon: 'gear', watts: 900, hours: 1 },
      { name: 'Bench Drill Press', icon: 'gear', watts: 750, hours: 2 },
      { name: 'Conveyor Belt Motor', icon: 'gear', watts: 1500, hours: 8 },
      { name: 'CNC Machine', icon: 'gear', watts: 3000, hours: 6 },
      { name: 'Industrial Fan', icon: 'fan', watts: 200, hours: 8 },
      { name: 'Lathe Machine', icon: 'gear', watts: 2200, hours: 4 },
      { name: 'Forklift Battery Charger', icon: 'truck', watts: 3000, hours: 4 },
      { name: 'Industrial Water Pump', icon: 'pump', watts: 2200, hours: 6 },
      { name: 'Circular Saw', icon: 'saw', watts: 1500, hours: 2 }
    ],
    agriculture: [
      { name: 'Irrigation Pump', icon: 'pump', watts: 3000, hours: 6 },
      { name: 'Water Trough Pump', icon: 'pump', watts: 500, hours: 4 },
      { name: 'Electric Fence Energiser', icon: 'zap', watts: 30, hours: 24 },
      { name: 'Wool Shearing Machine', icon: 'gear', watts: 400, hours: 4 },
      { name: 'Grain Auger', icon: 'gear', watts: 4000, hours: 3 },
      { name: 'Milking Machine', icon: 'gear', watts: 1500, hours: 3 },
      { name: 'Electric Chainsaw', icon: 'saw', watts: 2000, hours: 1 },
      { name: 'Feed Mixer', icon: 'gear', watts: 3000, hours: 2 },
      { name: 'Cool Room / Chiller', icon: 'ac', watts: 1200, hours: 24 },
      { name: 'Shed Fan', icon: 'fan', watts: 150, hours: 10 },
      { name: 'Workshop Lighting', icon: 'bulb', watts: 60, hours: 6 }
    ]
  };

  /* ---------------- State ---------------- */
  var items = [];
  var uidCounter = 0;
  var activeCat = 'household';

  var els = {
    startBtn: document.getElementById('ggp-start-btn'),
    intro: document.getElementById('ggp-intro'),
    app: document.getElementById('ggp-app'),
    tabs: document.getElementById('ggp-tabs'),
    grid: document.getElementById('ggp-appliance-grid'),
    customToggle: document.getElementById('ggp-add-custom-toggle'),
    customForm: document.getElementById('ggp-custom-form'),
    customName: document.getElementById('ggp-custom-name'),
    customWatts: document.getElementById('ggp-custom-watts'),
    customHours: document.getElementById('ggp-custom-hours'),
    customAddBtn: document.getElementById('ggp-custom-add-btn'),
    table: document.getElementById('ggp-table'),
    tbody: document.getElementById('ggp-table-body'),
    emptyMsg: document.getElementById('ggp-empty-msg'),
    totalWatts: document.getElementById('ggp-total-watts'),
    totalKwh: document.getElementById('ggp-total-kwh'),
    totalKva: document.getElementById('ggp-total-kva'),
    results: document.getElementById('ggp-results'),
    productsGrid: document.getElementById('ggp-products-grid'),
    noProducts: document.getElementById('ggp-no-products')
  };

  function escapeHtml(str) {
    return String(str).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  /* ---------------- Render appliance grid ---------------- */
  function renderGrid() {
    var list = APPLIANCES[activeCat] || [];
    els.grid.innerHTML = list.map(function (a, idx) {
      return '<button type="button" class="ggp-appliance-btn" data-cat="' + activeCat + '" data-idx="' + idx + '">' +
        '<span class="ggp-icon">' + (ICONS[a.icon] || ICONS.box) + '</span>' +
        '<span class="ggp-name">' + escapeHtml(a.name) + '<span class="ggp-sub">' + a.watts + 'W typical</span></span>' +
        '</button>';
    }).join('');
  }

  els.tabs.addEventListener('click', function (e) {
    var btn = e.target.closest('.ggp-tab');
    if (!btn) return;
    activeCat = btn.getAttribute('data-cat');
    Array.prototype.forEach.call(els.tabs.querySelectorAll('.ggp-tab'), function (t) {
      var isActive = t === btn;
      t.classList.toggle('active', isActive);
      t.setAttribute('aria-selected', isActive ? 'true' : 'false');
    });
    renderGrid();
  });

  els.grid.addEventListener('click', function (e) {
    var btn = e.target.closest('.ggp-appliance-btn');
    if (!btn) return;
    var cat = btn.getAttribute('data-cat');
    var idx = parseInt(btn.getAttribute('data-idx'), 10);
    var def = APPLIANCES[cat][idx];
    addItem(def.name, def.icon, def.watts, def.hours);
  });

  /* ---------------- Custom appliance ---------------- */
  els.customToggle.addEventListener('click', function () {
    els.customForm.hidden = !els.customForm.hidden;
    if (!els.customForm.hidden) els.customName.focus();
  });

  els.customAddBtn.addEventListener('click', function () {
    var name = els.customName.value.trim();
    var watts = parseFloat(els.customWatts.value);
    var hours = parseFloat(els.customHours.value);
    if (!name) { els.customName.focus(); return; }
    if (isNaN(watts) || watts < 0) { els.customWatts.focus(); return; }
    if (isNaN(hours) || hours < 0) { els.customHours.focus(); return; }
    addItem(name, 'box', watts, hours);
    els.customName.value = '';
    els.customWatts.value = '';
    els.customHours.value = '';
    els.customForm.hidden = true;
  });

  /* ---------------- Item list management ---------------- */
  function addItem(name, icon, watts, hours) {
    items.push({ uid: 'ggp-' + (uidCounter++), name: name, icon: icon, watts: watts, hours: hours, qty: 1 });
    renderList();
  }

  function removeItem(uid) {
    items = items.filter(function (it) { return it.uid !== uid; });
    renderList();
  }

  function updateItem(uid, field, value) {
    var it = items.filter(function (i) { return i.uid === uid; })[0];
    if (!it) return;
    it[field] = value;
    renderList();
  }

  function renderList() {
    var hasItems = items.length > 0;
    els.table.hidden = !hasItems;
    els.emptyMsg.hidden = hasItems;
    if (hasItems) {
      els.table.style.setProperty('display', 'table', 'important');
    } else {
      els.table.style.setProperty('display', 'none', 'important');
    }

    els.tbody.innerHTML = items.map(function (it) {
      var kwh = (it.watts * it.hours * it.qty / 1000);
      return '<tr data-uid="' + it.uid + '">' +
        '<td style="text-align:center !important;"><span class="ggp-item-name"><span class="ggp-icon">' + (ICONS[it.icon] || ICONS.box) + '</span>' + escapeHtml(it.name) + '</span></td>' +
        '<td style="text-align:center !important;"><input type="number" min="1" step="1" value="' + it.qty + '" data-field="qty"></td>' +
        '<td style="text-align:center !important;"><input type="number" min="0" step="1" value="' + it.watts + '" data-field="watts"></td>' +
        '<td style="text-align:center !important;"><input type="number" min="0" step="0.1" value="' + it.hours + '" data-field="hours"></td>' +
        '<td style="text-align:center !important;">' + kwh.toFixed(2) + '</td>' +
        '<td style="text-align:center !important;"><button type="button" class="ggp-remove-btn" aria-label="Remove">&times;</button></td>' +
        '</tr>';
    }).join('');

    computeTotals();
  }

  els.tbody.addEventListener('input', function (e) {
    var input = e.target;
    if (input.tagName !== 'INPUT') return;
    var row = input.closest('tr');
    var uid = row.getAttribute('data-uid');
    var field = input.getAttribute('data-field');
    var value = parseFloat(input.value);
    if (isNaN(value) || value < 0) return;
    var it = items.filter(function (i) { return i.uid === uid; })[0];
    if (!it) return;
    it[field] = value;
    var kwhCell = row.children[4];
    kwhCell.textContent = (it.watts * it.hours * it.qty / 1000).toFixed(2);
    computeTotals();
  });

  els.tbody.addEventListener('click', function (e) {
    var btn = e.target.closest('.ggp-remove-btn');
    if (!btn) return;
    var row = btn.closest('tr');
    removeItem(row.getAttribute('data-uid'));
  });

  /* ---------------- Totals + product matching ---------------- */
  function computeTotals() {
    var totalWatts = 0;
    var totalKwh = 0;
    items.forEach(function (it) {
      totalWatts += it.watts * it.qty;
      totalKwh += (it.watts * it.hours * it.qty) / 1000;
    });
    var requiredKva = (totalWatts * SAFETY_MARGIN) / (1000 * POWER_FACTOR);

    els.totalWatts.textContent = Math.round(totalWatts).toLocaleString() + ' W';
    els.totalKwh.textContent = totalKwh.toFixed(1) + ' kWh/day';
    els.totalKva.textContent = requiredKva.toFixed(1) + ' kVA';

    renderSuggestions(requiredKva);
  }

  function renderSuggestions(requiredKva) {
    if (items.length === 0 || requiredKva <= 0) {
      els.results.hidden = true;
      return;
    }
    els.results.hidden = false;

    var matches = PRODUCTS.filter(function (p) { return p.kva >= requiredKva; })
      .sort(function (a, b) { return a.kva - b.kva; })
      .slice(0, 3);

    if (matches.length === 0) {
      matches = PRODUCTS.slice().sort(function (a, b) { return b.kva - a.kva; }).slice(0, 3);
    }

    els.noProducts.hidden = matches.length > 0;
    els.productsGrid.innerHTML = matches.map(function (p) {
      var img = p.image ? '<img class="ggp-product-img" src="' + escapeHtml(p.image) + '" alt="' + escapeHtml(p.title) + '" loading="lazy">' : '';
      return '<a class="ggp-product-card" href="' + escapeHtml(p.url) + '">' +
        img +
        '<div class="ggp-product-body">' +
        '<p class="ggp-product-title">' + escapeHtml(p.title) + '</p>' +
        '<div class="ggp-product-meta"><span class="ggp-product-kva">' + p.kva + ' kVA</span>' + (p.price ? '<span class="ggp-product-price">' + escapeHtml(p.price) + '</span>' : '') + '</div>' +
        '<div class="ggp-product-cta">View Product &rarr;</div>' +
        '</div></a>';
    }).join('');
  }

  /* ---------------- Start ---------------- */
  els.startBtn.addEventListener('click', function () {
    els.intro.hidden = true;
    els.app.hidden = false;
    els.app.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  renderGrid();
})();
</script>

{% schema %}
{
  "name": "GGP Power Calculator",
  "settings": [
    {
      "type": "header",
      "content": "Product matching"
    },
    {
      "type": "collection",
      "id": "product_collection",
      "label": "Generator collection",
      "info": "Products in this collection are matched against the calculated kVA requirement. Only products with a value in the kVA metafield below are considered."
    },
    {
      "type": "text",
      "id": "kva_namespace",
      "label": "kVA metafield namespace",
      "default": "custom"
    },
    {
      "type": "text",
      "id": "kva_key",
      "label": "kVA metafield key",
      "default": "prime_power",
      "info": "Together with the namespace above, this points at product.metafields.custom.prime_power (or whatever you set)."
    },
    {
      "type": "header",
      "content": "Contact"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact page link",
      "info": "Where the final \"Talk to Our Team\" button sends visitors."
    },
    {
      "type": "header",
      "content": "Sizing formula"
    },
    {
      "type": "range",
      "id": "power_factor",
      "label": "Power factor",
      "min": 0.5,
      "max": 1,
      "step": 0.05,
      "default": 0.8,
      "info": "Used to convert total watts into kVA. 0.8 is typical for mixed loads."
    },
    {
      "type": "range",
      "id": "safety_margin",
      "label": "Safety margin",
      "min": 1,
      "max": 2,
      "step": 0.05,
      "default": 1.3,
      "info": "Headroom added on top of connected load, e.g. 1.3 = 30% extra capacity."
    }
  ],
  "presets": [
    {
      "name": "GGP Power Calculator"
    }
  ]
}
{% endschema %}
